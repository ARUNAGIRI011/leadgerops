{
  "doctype": "DocType",
  "name": "LedgerOps Contact",
  "module": "LedgerOps",
  "autoname": "format:CON-{####}",
  "track_changes": 1,
  "fields": [
    {
      "fieldname": "full_name",
      "label": "Full Name",
      "fieldtype": "Data",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "account",
      "label": "Customer Account",
      "fieldtype": "Link",
      "options": "LedgerOps Account",
      "in_list_view": 1
    },
    {
      "fieldname": "email",
      "label": "Email",
      "fieldtype": "Data"
    },
    {
      "fieldname": "phone",
      "label": "Phone",
      "fieldtype": "Data"
    },
    {
      "fieldname": "job_title",
      "label": "Job Title",
      "fieldtype": "Data"
    },
    {
      "fieldname": "is_primary",
      "label": "Primary Contact",
      "fieldtype": "Check"
    },
    {
      "fieldname": "contact_preference",
      "label": "Preferred Contact",
      "fieldtype": "Select",
      "options": "Email\nPhone\nOther"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0,
      "report": 1,
      "export": 0,
      "share": 0
    }
  ]
}
