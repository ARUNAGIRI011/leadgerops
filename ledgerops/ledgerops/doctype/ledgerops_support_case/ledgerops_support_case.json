{
  "doctype": "DocType",
  "name": "LedgerOps Support Case",
  "module": "LedgerOps",
  "autoname": "format:SUP-{####}",
  "track_changes": 1,
  "fields": [
    {
      "fieldname": "subject",
      "label": "Subject",
      "fieldtype": "Data",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "account",
      "label": "Customer Account",
      "fieldtype": "Link",
      "options": "LedgerOps Account",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "contact_email",
      "label": "Contact Email",
      "fieldtype": "Data"
    },
    {
      "fieldname": "priority",
      "label": "Priority",
      "fieldtype": "Select",
      "options": "Low\nNormal\nHigh\nUrgent",
      "default": "Normal",
      "in_list_view": 1
    },
    {
      "fieldname": "status",
      "label": "Status",
      "fieldtype": "Select",
      "options": "Open\nIn Progress\nWaiting on Customer\nResolved\nClosed",
      "default": "Open",
      "in_list_view": 1
    },
    {
      "fieldname": "assigned_to",
      "label": "Assigned To",
      "fieldtype": "Link",
      "options": "User"
    },
    {
      "fieldname": "category",
      "label": "Category",
      "fieldtype": "Select",
      "options": "Billing\nOnboarding\nImport\nReconciliation\nAI Assistant\nSecurity\nOther"
    },
    {
      "fieldname": "description",
      "label": "Description",
      "fieldtype": "Text"
    },
    {
      "fieldname": "resolution",
      "label": "Resolution",
      "fieldtype": "Text"
    },
    {
      "fieldname": "opened_on",
      "label": "Opened On",
      "fieldtype": "Datetime"
    },
    {
      "fieldname": "resolved_on",
      "label": "Resolved On",
      "fieldtype": "Datetime"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0,
      "report": 1,
      "export": 0,
      "share": 0
    }
  ]
}
