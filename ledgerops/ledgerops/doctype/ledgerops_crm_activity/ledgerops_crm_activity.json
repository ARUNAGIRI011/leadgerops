{
  "doctype": "DocType",
  "name": "LedgerOps CRM Activity",
  "module": "LedgerOps",
  "autoname": "format:CRM-{####}",
  "track_changes": 1,
  "fields": [
    {
      "fieldname": "subject",
      "label": "Subject",
      "fieldtype": "Data",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "activity_type",
      "label": "Activity Type",
      "fieldtype": "Select",
      "options": "Call\nEmail\nMeeting\nDemo\nTask\nNote",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "related_lead",
      "label": "Related Lead",
      "fieldtype": "Link",
      "options": "LedgerOps Lead"
    },
    {
      "fieldname": "related_account",
      "label": "Related Customer",
      "fieldtype": "Link",
      "options": "LedgerOps Account"
    },
    {
      "fieldname": "due_date",
      "label": "Due Date",
      "fieldtype": "Datetime"
    },
    {
      "fieldname": "assigned_to",
      "label": "Assigned To",
      "fieldtype": "Link",
      "options": "User"
    },
    {
      "fieldname": "status",
      "label": "Status",
      "fieldtype": "Select",
      "options": "Open\nIn Progress\nCompleted\nCancelled",
      "default": "Open",
      "in_list_view": 1
    },
    {
      "fieldname": "description",
      "label": "Details",
      "fieldtype": "Text"
    },
    {
      "fieldname": "completed_on",
      "label": "Completed On",
      "fieldtype": "Datetime"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0,
      "report": 1,
      "export": 0,
      "share": 0
    }
  ]
}
