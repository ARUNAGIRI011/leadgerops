{
  "doctype": "DocType",
  "name": "LedgerOps Evidence Request",
  "module": "LedgerOps",
  "custom": 0,
  "istable": 0,
  "is_submittable": 0,
  "is_tree": 0,
  "editable_grid": 0,
  "engine": "InnoDB",
  "autoname": "hash",
  "track_changes": 1,
  "allow_rename": 0,
  "fields": [
    {
      "fieldname": "client",
      "label": "Client",
      "fieldtype": "Link",
      "options": "LedgerOps Client",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "exception",
      "label": "Exception",
      "fieldtype": "Link",
      "options": "LedgerOps Exception",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "request_text",
      "label": "Request Text",
      "fieldtype": "Small Text",
      "reqd": 1
    },
    {
      "fieldname": "due_date",
      "label": "Due Date",
      "fieldtype": "Date"
    },
    {
      "fieldname": "status",
      "label": "Status",
      "fieldtype": "Select",
      "options": "Draft\nSent\nReceived\nCancelled",
      "default": "Draft",
      "in_list_view": 1
    },
    {
      "fieldname": "evidence_file",
      "label": "Evidence File",
      "fieldtype": "Attach",
      "description": "Attach only private, access-controlled evidence files."
    }
  ],
  "field_order": [
    "client",
    "exception",
    "request_text",
    "due_date",
    "status",
    "evidence_file"
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "share": 1,
      "print": 1,
      "email": 1,
      "export": 1,
      "report": 1,
      "import": 1
    }
  ],
  "actions": [],
  "links": [],
  "states": []
}
